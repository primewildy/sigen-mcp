# Copy to ~/.config/sigen-mcp/env (or point SIGEN_MCP_ENV_FILE at it) and chmod 600.
# Any of these can also be set as environment variables in your MCP client config,
# which take precedence over this file.

# --- Sigen login (the same as the mySigen app) ---------------------------------
SIGEN_USERNAME=you@example.com
SIGEN_PASSWORD=
# eu (Europe, UK, Middle East & Africa), apac, cn or us
SIGEN_REGION=eu

# Optional overrides; normally read from your Sigen station
# SIGEN_TIMEZONE=Europe/London
# CURRENCY_SYMBOL=£

# --- Tariff (optional; without it you get energy figures but no money) ---------
# TARIFF_SOURCE: none | fixed | octopus
TARIFF_SOURCE=none

# fixed: prices in minor units (pence/cents) per kWh, standing charge per day.
# Either one flat price, or a time-of-use schedule of local start times:
# IMPORT_RATE=24.5
# IMPORT_RATE=02:00=14.58,05:00=24.29,16:00=34.01,19:00=24.29
# EXPORT_RATE=15
# STANDING_CHARGE=50

# octopus (UK): prices come live from Octopus's public API.
# Product codes are on your Octopus account page or at https://api.octopus.energy/v1/products/
# Set either your region letter (A–P) or your postcode to look it up.
# OCTOPUS_IMPORT_PRODUCT=FLUX-IMPORT-23-02-14
# OCTOPUS_EXPORT_PRODUCT=FLUX-EXPORT-23-02-14
# OCTOPUS_REGION=A
# OCTOPUS_POSTCODE=SW1A 1AA

# --- Switched tariff recently? (optional) ---------------------------------------
# Days before these dates use the PREVIOUS_* prices (same formats as above);
# if those aren't set, money for those days is reported as unknown.
# TARIFF_IMPORT_FROM=2026-01-31
# TARIFF_EXPORT_FROM=2026-01-31
# PREVIOUS_IMPORT_RATE=24.5
# PREVIOUS_EXPORT_RATE=15
# PREVIOUS_STANDING_CHARGE=50
